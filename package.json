{
  "name": "@sandy3002/mastra-integration-serpapi",
  "version": "0.1.0",
  "description": "SerpApi integration for Mastra",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node -e \"import('./dist/index.js').then(m => { console.log('exports:', Object.keys(m)); console.log(m.createSerpApiSearchTool()); })\""
  },
  "peerDependencies": {
    "@mastra/core": ">=0.0.0",
    "serpapi": ">=2.0.0",
    "zod": ">=3.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "serpapi": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "author": "sandy3002",
  "license": "ISC"
}
