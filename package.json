{
  "name": "@sandy3002/mastra-integration-serpapi",
  "version": "1.0.1",
  "description": "SerpApi integration for Mastra — vertical search targeting with deterministic engine routing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.67.0 <2.0.0",
    "serpapi": ">=2.0.0 <3.0.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "msw": "^2.15.0",
    "tsd": "^0.33.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "author": "sandy3002",
  "license": "ISC"
}
